{
  "name": "codevault",
  "version": "1.0.0",
  "description": "CodeVault — Developer Code Snippet Management and Sharing Platform",
  "scripts": {
    "install:server": "npm --prefix server install",
    "install:client": "npm --prefix client install",
    "install:all": "npm run install:server && npm run install:client",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "build:client": "npm --prefix client run build",
    "test:server": "npm --prefix server test",
    "seed": "npm --prefix server run seed"
  },
  "keywords": [
    "codevault",
    "react",
    "express",
    "mongodb-atlas",
    "snippets"
  ],
  "author": "CodeVault Team",
  "license": "MIT"
}

